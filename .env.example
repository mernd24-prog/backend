// Example .env file for development environment

NODE_ENV=development
LOG_PRETTY=true
LOG_LEVEL=warn
PORT=4000
APP_NAME=ecommerce
API_PREFIX=/api/v1
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
MONGO_URI=mongodb://0.0.0.0:27017/ecommerce
POSTGRES_URL=postgresql://postgres:change-me@localhost:5432/ecommerce
# Keep local/dev pools modest when Postgres is shared or has a low connection limit.
POSTGRES_POOL_MAX=5
POSTGRES_CONNECTION_TIMEOUT_MS=30000
KNEX_POOL_MIN=0
KNEX_POOL_MAX=5
KNEX_ACQUIRE_TIMEOUT_MS=30000
SEQUELIZE_POOL_MIN=0
SEQUELIZE_POOL_MAX=5
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_NODE=http://localhost:9200
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
ENABLE_CLOUDINARY=true
ENABLE_LOCAL_UPLOAD_STORAGE=false
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
DEFAULT_FROM_EMAIL=no-reply@example.com
ENABLE_CRON=true
PRODUCTION=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Sam Global <no-reply@example.com>"
 


 
