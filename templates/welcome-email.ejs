<%
  const escapeHtml = (value = "") =>
    String(value ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");

  const brandName = typeof brand !== "undefined" && brand
    ? brand
    : process.env.EMAIL_BRAND_NAME || process.env.BRAND_NAME || "Sam Global";
  const headerBrandName = process.env.EMAIL_HEADER_BRAND_NAME ||
    brandName.replace(/\s+E-?Commerce$/i, "") ||
    "Sam Global";
  const customerBaseUrl = String(
    process.env.CUSTOMER_APP_BASE_URL ||
      process.env.FRONTEND_PUBLIC_URL ||
      process.env.APP_PUBLIC_URL ||
      "https://staging.samglobal1.com",
  ).replace(/\/+$/, "");
  const shoppingUrl = String(process.env.CUSTOMER_APP_BASE_URL || "").replace(/\/+$/, "");
  const heroSrc = typeof heroUrl !== "undefined" && heroUrl
    ? heroUrl
    : process.env.EMAIL_ACCOUNT_HERO_URL ||
      process.env.EMAIL_AUTH_HERO_URL ||
      `${customerBaseUrl}/email-assets/auth-security-hero.png`;
  const logoSrc = typeof logoUrl !== "undefined" && logoUrl
    ? logoUrl
    : process.env.EMAIL_LOGO_URL || "";
  const displayName = escapeHtml(String(
    typeof firstName !== "undefined" && firstName ? firstName : "User",
  ).trim());
  const currentYear = new Date().getFullYear();
%>
<!doctype html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome to <%= escapeHtml(brandName) %></title>
    <style>
      @media only screen and (max-width: 520px) {
        .sg-wrapper { padding: 16px 8px !important; }
        .sg-card { border-radius: 8px !important; }
        .sg-header { padding: 14px 16px !important; }
        .sg-body { padding: 14px 16px 8px !important; }
        .sg-title { font-size: 21px !important; }
        .sg-brand-text { font-size: 11px !important; letter-spacing: 1.3px !important; white-space: nowrap !important; }
        .sg-hero-icon { width: 148px !important; }
        .sg-hero-art { width: 148px !important; max-width:148px !important; }
      }
    </style>
  </head>
  <body style="margin:0;background:#f3f4f6;font-family:Arial,Helvetica,sans-serif;color:#111827;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="sg-wrapper" style="background:#f3f4f6;padding:12px 8px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="sg-card" style="max-width:600px;background:#ffffff;border-radius:8px;">
            <tr>
              <td class="sg-header" style="background:#0a1450;padding:14px 20px;border-radius:8px 8px 0 0;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                  <tr>
                    <td valign="top">
                      <table role="presentation" cellpadding="0" cellspacing="0">
                        <tr>
                          <td width="48" valign="middle" style="padding-right:8px;">
                            <% if (logoSrc) { %>
                              <img src="<%= escapeHtml(logoSrc) %>" width="40" alt="<%= escapeHtml(brandName) %>" style="display:block;width:40px;max-width:100%;height:auto;border:0;outline:none;text-decoration:none;">
                            <% } else { %>
                              <span style="display:inline-block;width:28px;height:28px;border-radius:50%;background:#d9a327;color:#0a1450;font-size:12px;line-height:28px;text-align:center;font-weight:800;">&#9737;</span>
                            <% } %>
                          </td>
                          <td valign="middle">
                            <div class="sg-brand-text" style="font-size:11px;line-height:1.3;color:#ffc34d;text-transform:uppercase;letter-spacing:1.4px;font-weight:800;white-space:nowrap;"><%= escapeHtml(headerBrandName) %></div>
                          </td>
                        </tr>
                      </table>
                      <h1 class="sg-title" style="margin:10px 0 2px;font-size:22px;line-height:1.25;color:#ffffff;font-weight:800;mso-line-height-rule:exactly;">Welcome to <%= escapeHtml(brandName) %></h1>
                      <p style="margin:2px 0 0;font-size:11px;line-height:1.5;color:#dbe6ff;">Your account is ready</p>
                    </td>
                    <td class="sg-hero-icon" width="148" align="right" valign="middle">
                      <img class="sg-hero-art" src="<%= escapeHtml(heroSrc) %>" width="168" height="95" alt="" style="display:block;width:168px;max-width:168px;height:auto;border:0;outline:none;text-decoration:none;">
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <td class="sg-body" style="padding:14px 20px 8px;">
                <p style="margin:0 0 10px;font-size:16px;line-height:1.5;color:#0a1450;font-weight:800;">Hello <%= displayName %>,</p>
                <p style="margin:0 0 12px;font-size:12px;line-height:1.45;color:#0a1450;">Your account is active. Explore products, manage your cart, or start selling.</p>
                <% if (shoppingUrl) { %>
                <p style="margin:14px 0;"><a href="<%= escapeHtml(shoppingUrl) %>" style="display:inline-block;background:#d9a327;color:#0a1450;padding:12px 22px;border-radius:6px;font-size:13px;font-weight:bold;text-decoration:none;">Start shopping</a></p>
                <% } %>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:20px;border-top:1px solid #e5e7eb;table-layout:fixed;"><tr>
<% [["lock", "Secure & Trusted", "Updates from official systems."], ["shield", "Protection", "Review details in your account."], ["chat", "Need Help?", "Contact official support."]].forEach(function(item, index) { %>
<td width="33%" valign="top" style="padding:14px 8px;<%= index ? 'border-left:1px solid #e5e7eb;' : '' %>"><table role="presentation" cellpadding="0" cellspacing="0"><tr><td valign="top" style="padding-right:8px;"><img src="<%= customerBaseUrl %>/email-assets/icons/<%= item[0] %>.png" width="36" height="36" alt="" style="display:block;width:36px;height:36px;border:0;"></td><td valign="top"><div style="font-size:12px;line-height:1.4;font-weight:bold;color:#0a1450;"><%= item[1] %></div><div style="font-size:10px;line-height:1.4;color:#6b7280;margin-top:2px;"><%= item[2] %></div></td></tr></table></td>
<% }); %>
</tr></table>
              </td>
            </tr>
            <tr>
              <td align="center" style="background:#ffffff;border-top:1px solid #e6e9f2;padding:8px 20px 12px;">
                <p style="margin:0;font-size:11px;line-height:1.7;color:#8a91a7;">This is an automated account email from <%= escapeHtml(brandName) %>. Please do not reply to this email. For assistance, contact <a href="mailto:samglobalsupport@gmail.com" style="color:#1d4ed8;text-decoration:underline;">samglobalsupport@gmail.com</a>.</p>
                <p style="margin:12px 0 0;font-size:11px;line-height:1.7;color:#8a91a7;">&#128274; &copy; <%= currentYear %> <%= escapeHtml(brandName) %>. All rights reserved.</p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
